{
    "name": "silvershop/newsletter-laposta",
    "description": "Laposta ESP adapter for silvershop/newsletter: syncs subscribers to a Laposta list via a thin Guzzle client, with a webhook back to the local list.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "newsletter", "laposta", "esp"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-newsletter-laposta/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silvershop/newsletter": "dev-main",
        "guzzlehttp/guzzle": "^7"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/sqlite3": "^4"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/silvershop-suite/silvershop-newsletter.git"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Newsletter\\Laposta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Newsletter\\Laposta\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
