<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="vendor/silverstripe/cms/tests/bootstrap.php" colors="true" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.3/phpunit.xsd">
  <!--
    Self-contained in-memory SQLite test database so `vendor/bin/phpunit` runs without the caller having to
    export SS_* env vars. Not forced (plain <env>), so CI (which sets these inline) and a developer overriding
    the DB on the command line still take precedence.
  -->
  <php>
    <env name="SS_ENVIRONMENT_TYPE" value="dev"/>
    <env name="SS_DATABASE_CLASS" value="SQLite3Database"/>
    <env name="SS_DATABASE_NAME" value="ss_test"/>
    <env name="SS_SQLITE_DATABASE_PATH" value=":memory:"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">src/</directory>
    </include>
  </source>
  <testsuites>
    <testsuite name="Default">
      <directory>tests/php</directory>
    </testsuite>
  </testsuites>
</phpunit>
